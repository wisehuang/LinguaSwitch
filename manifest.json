{
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "name": "LinguaSwitch",
  "version": "1.5",
  "description": "Translate text into your chosen language with OpenAI models, from the popup or the right-click menu.",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
